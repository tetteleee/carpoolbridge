{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* @repository・@app-shellエイリアス（実体はvite.config.tsのresolve.aliasで
       ビルドmodeにより切り替わる。tscでの型チェック用に自チーム版を参照先とする。
       ref: docs/10_DexieRepository実装設計.md#2 */
    "paths": {
      "@repository": ["./src/repositories/firestore/index.ts"],
      "@app-shell": ["./src/appShell/CloudAppShell.tsx"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
