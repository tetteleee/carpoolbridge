{
  "name": "carpoolbridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --config=playwright.public.config.ts",
    "seed": "tsx scripts/seed/seed.ts",
    "seed:local": "SEED_SOURCE=local tsx scripts/seed/seed.ts",
    "seed:from-csv": "tsx scripts/seed/csvToLocalJson.ts"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
